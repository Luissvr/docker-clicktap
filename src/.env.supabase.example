# Copiar los valores a src/.env, conservando APP_KEY existente.
# Host/usuario exactos: Supabase > Connect > Session pooler (5432).
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=REEMPLAZAR_HOST_SESSION_POOLER
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.defhqrpytvicaenrrado
DB_PASSWORD="REEMPLAZAR_CONTRASENA"
DB_SCHEMA=clicktap
DB_SSLMODE=require

# Desarrollo con una sola instancia: datos temporales en el volumen local.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database

# Supabase Storage > S3: claves de acceso S3, no publishable ni contraseña SQL.
# Crear bucket privado clicktap-assets antes de habilitar el disco.
CLICKTAP_MEDIA_DISK=supabase
SUPABASE_S3_ENDPOINT=https://defhqrpytvicaenrrado.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=REEMPLAZAR_REGION
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=clicktap-assets
